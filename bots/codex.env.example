# Copy to bots/<any-name>.env, fill in, then: ./ctl.sh start <any-name>
# CLI sign-in (once): codex login

# Which AI runs this bot: claude | codex | gemini
PROVIDER=codex

# Name shown in replies (default: Codex) and an optional role the other agents see in debates
BOT_NAME=
ROLE=

# Discord bot token (Developer Portal → your app → Bot → Reset Token). Never share or commit it.
DISCORD_BOT_TOKEN=

# Folder the agent works in (a project, a notes vault, ...)
WORKSPACE_DIR=

# What the agent may do in WORKSPACE_DIR:
#   read-only  read files only (default, safest)
#   edit       read + create/edit files inside WORKSPACE_DIR
#   full       no limits: any command, any path. Only for a folder/machine you'd be fine losing.
PERMISSIONS=read-only

# Channels this bot answers in (comma-separated channel IDs). DMs always work.
ALLOWED_CHANNEL_IDS=

# Who may use this bot (comma-separated Discord user IDs). Empty = anyone who can post in those channels.
# Strongly recommended with edit/full.
ALLOWED_USER_IDS=

# Channels where bots may @mention each other and debate. Empty = off.
DEBATE_CHANNEL_IDS=
# Agent turns before a debate stops and waits for a human (default 4)
MAX_BOT_TURNS=

# Your name: the agents are told final decisions are yours
OWNER_NAME=

# How many recent channel messages the bot reads for context (default 20, max 100)
HISTORY_LIMIT=
