# Copy to ~/.config/discord-ai-team/standby.env on the Mac (see README, "Optional: Mac standby for a server").
PRIMARY_HOSTS="203.0.113.10"          # server address(es), space-separated; up if any answers on PRIMARY_PORT
PRIMARY_PORT=22
PRIMARY_NAME=my-server                # used in the DMs
FAIL_LIMIT=5                          # straight 1-minute failures before the alert
ALERT_USER_ID=                        # your Discord user ID; only your reactions start a bot
STANDBY_BOTS="claude:🟣 codex:🟢 gemini:🔵"   # bots/<name>.env keys and the reaction for each
MIRROR_SOURCE=                        # optional rsync source, e.g. my-server:notes/ (empty = no copy)
MIRROR_DIR=~/workspace-mirror         # point the Mac bots' WORKSPACE_DIR here if you use the copy
MIRROR_EVERY_MIN=1440                 # refresh the copy once a day
